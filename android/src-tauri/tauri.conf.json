{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mystic Falls",
  "version": "0.0.1",
  "identifier": "app.mysticfalls.pancake",
  "build": {
    "frontendDist": "../../dist/upgraded-pancake"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mystic Falls",
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "category": "Entertainment",
    "shortDescription": "Mystic Falls on your phone",
    "longDescription": "The upgraded-pancake Angular app packaged as an Android application: the same build the web deployment serves, loaded from inside the APK instead of over the network."
  }
}
